---
import type { Crumb } from '../layouts/Layout.astro';
interface Props {
  crumbs: Crumb[];
  light?: boolean;
}
const { crumbs, light = false } = Astro.props;
---
<nav aria-label="Você está em" class:list={['crumbs', { 'crumbs--light': light }]}>
  <ol>
    <li><a href="/">Início</a></li>
    {crumbs.map((c, i) => (
      <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .crumbs--light ol {
    color: #a9bdd4;
  }
</style>
