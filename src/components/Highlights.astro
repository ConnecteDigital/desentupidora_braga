---
import Icon from './Icon.astro';
import { highlights } from '../data/site';
---
<section class="highlights">
  <div class="container highlights__grid">
    {highlights.map((h) => (
      <div class="hl">
        <span class="hl__icon"><Icon name={h.icon} size={26} /></span>
        <div>
          <p class="hl__title">{h.title}</p>
          <p class="hl__text">{h.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .highlights {
    position: relative;
    z-index: 2;
    margin-top: -40px;
  }
  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .hl {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #fff;
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .hl__icon {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #fff0e6;
    color: var(--accent);
  }
  .hl__title {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 2px;
  }
  .hl__text {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }
  @media (max-width: 1000px) {
    .highlights__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .highlights {
      margin-top: -28px;
    }
    .highlights__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .hl {
      padding: 14px 16px;
    }
  }
</style>
