---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Perguntas frequentes' } = Astro.props;
---
<div class="faq">
  <h2>{title}</h2>
  {items.map((item, i) => (
    <details open={i === 0}>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq details {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    margin-bottom: 10px;
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 48px 16px 20px;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--navy);
    position: relative;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--accent);
  }
  .faq details[open] summary::after {
    content: '–';
  }
  .faq details p {
    padding: 0 20px 16px;
    margin: 0;
    color: var(--muted);
  }
</style>
