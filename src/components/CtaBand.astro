---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Entupiu? A gente resolve agora.',
  text = `Equipe de plantão 24 horas e chegada em ${site.arrival}. Fale com a gente pelo WhatsApp ou ligue.`,
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> WhatsApp</a>
      <a class="btn btn--light" href={site.phoneHref}><Icon name="phone" size={20} /> {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.18), transparent 40%),
      linear-gradient(120deg, var(--accent), #ff7d2e);
    color: #fff;
    padding: 56px 0;
  }
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }
  .cta h2 {
    color: #fff;
    margin-bottom: 6px;
  }
  .cta p {
    margin: 0;
    font-size: 1.05rem;
    color: #fff4ea;
  }
</style>
