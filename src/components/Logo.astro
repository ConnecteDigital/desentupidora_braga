---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
const file = light ? 'logo-branca' : 'logo';
---
<picture class="logo">
  <source srcset={`/img/${file}.webp`} type="image/webp" />
  <img src={`/img/${file}.png`} alt="Desentupidora Braga" width="610" height="160" />
</picture>

<style>
  .logo img {
    display: block;
    height: 52px;
    width: auto;
  }
  @media (max-width: 720px) {
    .logo img {
      height: 40px;
    }
  }
</style>
