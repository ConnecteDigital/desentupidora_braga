---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import CityLinks from '../components/CityLinks.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../data/site';
import { services, groups } from '../data/services';
import { bairros } from '../data/bairros';
import { faqSchema } from '../lib/schema';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const faq = [
  { q: 'A Desentupidora Braga atende 24 horas?', a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, inclusive fins de semana e feriados, em Porto Alegre e cidades vizinhas.' },
  { q: 'Em quanto tempo a equipe chega?', a: `Mantemos equipes de plantão espalhadas pela região para chegar em cerca de ${site.arrival} após o chamado.` },
  { q: 'Vocês fazem limpeza de fossa com caminhão?', a: 'Sim. A limpeza de fossa séptica, sumidouro e caixa de gordura é feita com caminhão de sucção a vácuo, com descarte correto dos resíduos.' },
  { q: 'Quais cidades vocês atendem?', a: 'Porto Alegre e cidades vizinhas como Canoas, Gravataí, Cachoeirinha, Alvorada, Viamão, Esteio, Sapucaia do Sul, São Leopoldo, Novo Hamburgo, Guaíba, Eldorado do Sul e Nova Santa Rita.' },
  { q: 'Atendem condomínios e empresas?', a: 'Sim. Além de residências, atendemos condomínios, comércios, restaurantes e indústrias, com chamados emergenciais e manutenção preventiva.' },
  { q: 'Como peço um orçamento?', a: 'É só chamar no WhatsApp ou ligar. Conte o que está acontecendo e o endereço, e a equipe orienta e passa o orçamento.' },
];

const why = [
  { icon: 'clock', title: 'Plantão 24h de verdade', text: 'Atendemos de madrugada, fins de semana e feriados, com a mesma agilidade do horário comercial.' },
  { icon: 'bolt', title: `Chegada em ${site.arrival}`, text: 'Equipes distribuídas por Porto Alegre e região metropolitana para chegar rápido.' },
  { icon: 'truck', title: 'Equipamento completo', text: 'Máquinas rotativas, hidrojateamento de alta pressão e caminhão limpa fossa.' },
  { icon: 'building', title: 'Casas, prédios e empresas', text: 'Do ralo do banheiro à coluna do condomínio e à rede da indústria.' },
];
---
<Layout
  title="Desentupidora em Porto Alegre 24h | Limpa Fossa | Desentupidora Braga"
  description={`Desentupidora e limpa fossa 24 horas em Porto Alegre e região. Chegamos em ${site.arrival}. Desentupimento de esgoto, pia, vaso, ralo, cano, coluna e hidrojateamento. Ligue ${site.phoneDisplay}.`}
  schema={[faqSchema(faq)]}
>
  <Hero
    home
    eyebrow="Equipe de plantão agora em Porto Alegre"
    title="Desentupidora e Limpa Fossa <em>24 horas</em> em Porto Alegre e região"
    subtitle={`Pia, vaso, ralo, esgoto ou fossa entupida? Chegamos em ${site.arrival} com equipamento profissional para resolver na hora, de dia ou de madrugada.`}
  />
  <Highlights />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Desentupimento e limpa fossa em um só lugar</h2>
        <p>Atendemos residências, condomínios, comércios e indústrias com a técnica certa para cada problema.</p>
      </div>
      {(Object.keys(groups) as (keyof typeof groups)[]).map((g) => (
        <div class="group">
          <h3 class="group__title"><span>{groups[g].title}</span> <small>{groups[g].text}</small></h3>
          <ServiceCards items={services.filter((s) => s.group === g)} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section--navy">
    <div class="container about">
      <div class="about__media">
        <Foto keys={['geral/equipe', 'geral/caminhao']} alt="Equipe e caminhão da Desentupidora Braga" icon="truck" widths={[600, 1000]} sizes="(max-width: 960px) 100vw, 520px" />
      </div>
      <div>
        <span class="eyebrow">Por que a Braga</span>
        <h2>Atendimento rápido, sem enrolação e com equipamento de verdade</h2>
        <p>
          Entupimento não marca hora. Por isso a Desentupidora Braga mantém equipes de plantão 24 horas em Porto Alegre e cidades vizinhas, prontas para sair assim que você chama.
        </p>
        <div class="why">
          {why.map((w) => (
            <div class="why__item">
              <span><Icon name={w.icon} size={22} /></span>
              <div>
                <p class="why__title">{w.title}</p>
                <p>{w.text}</p>
              </div>
            </div>
          ))}
        </div>
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Falar com a equipe</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao cano liberado</h2>
      </div>
      <Steps
        items={[
          { title: 'Você chama', text: 'Pelo WhatsApp ou telefone, a qualquer hora. Conte o problema e o endereço.' },
          { title: 'Chegamos rápido', text: `A equipe de plantão mais próxima vai até você em cerca de ${site.arrival}.` },
          { title: 'Diagnóstico e orçamento', text: 'Identificamos a causa e explicamos o serviço antes de começar.' },
          { title: 'Problema resolvido', text: 'Desentupimos, limpamos o local e testamos tudo antes de sair.' },
        ]}
      />
    </div>
  </section>

  <section class="section" id="area">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Área de atendimento</span>
        <h2>Desentupidora em Porto Alegre e cidades vizinhas</h2>
        <p>Equipes circulando pela capital e pela Região Metropolitana para chegar rápido onde você estiver.</p>
      </div>
      <CityLinks />
      <h3 class="bairros-title">Bairros de Porto Alegre</h3>
      <ul class="tag-list">
        {bairros.slice(0, 24).map((b) => <li><a href={`/desentupidora-em-porto-alegre/${b.slug}/`}>{b.name}</a></li>)}
        <li><a href="/desentupidora-em-porto-alegre/#bairros">Ver todos os bairros →</a></li>
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Blog</span>
          <h2>Dicas para evitar entupimentos</h2>
        </div>
        <div class="grid grid--3">
          {posts.map((p) => (
            <article class="card post">
              <a href={`/blog/${p.id}/`} tabindex="-1" aria-hidden="true">
                <Foto keys={[`blog/${p.id}`]} alt={p.data.title} icon={p.data.icon} />
              </a>
              <div class="post__body">
                <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="center"><a class="btn btn--ghost" href="/blog/">Ver todos os artigos <Icon name="arrow" size={18} /></a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container faq-wrap">
      <FAQ items={faq} />
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .group + .group {
    margin-top: 56px;
  }
  .group__title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 1.4rem;
    margin-bottom: 22px;
  }
  .group__title span {
    box-shadow: inset 0 -3px 0 var(--accent);
    padding-bottom: 6px;
  }
  .group__title small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: center;
  }
  .about__media :global(.foto) {
    border-radius: 20px;
    aspect-ratio: 1 / 1;
  }
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 28px 0;
  }
  .why__item {
    display: flex;
    gap: 12px;
  }
  .why__item > span {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: rgba(255, 107, 0, 0.15);
    color: var(--accent);
  }
  .why__item p {
    margin: 0;
    font-size: 0.93rem;
    color: #b9c9dc;
  }
  .why__item .why__title {
    color: #fff;
    font-weight: 600;
    font-family: var(--font-head);
    margin-bottom: 2px;
  }
  .bairros-title {
    margin: 40px 0 16px;
    text-align: center;
  }
  .tag-list {
    justify-content: center;
  }
  .post__body {
    padding: 20px;
  }
  .post h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  .post p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .center {
    text-align: center;
    margin-top: 32px;
  }
  .faq-wrap {
    max-width: 820px;
  }
  @media (max-width: 960px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about__media :global(.foto) {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 560px) {
    .why {
      grid-template-columns: 1fr;
    }
  }
</style>
