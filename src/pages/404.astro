---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../data/site';
---
<Layout title="Página não encontrada | Desentupidora Braga" description="A página que você procura não existe." noindex>
  <section class="section">
    <div class="container nf">
      <h1>Página não encontrada</h1>
      <p>Essa página entupiu... mas o seu problema a gente resolve. Volte para o início ou fale com a equipe agora.</p>
      <div class="btn-row">
        <a class="btn btn--ghost" href="/">Ir para o início</a>
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>
        <a class="btn btn--call" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .nf {
    text-align: center;
    max-width: 640px;
    padding: 40px 20px;
  }
  .nf .btn-row {
    justify-content: center;
  }
</style>
