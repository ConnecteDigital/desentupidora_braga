---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { site } from '../data/site';
import { cities } from '../data/cities';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, crumbs = [], schema = [], ogImage, ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL(ogImage ?? '/og-image.png', site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': `${site.url}/#empresa`,
  name: site.name,
  url: site.url,
  telephone: `+${site.phone}`,
  image,
  logo: new URL('/img/logo.png', site.url).href,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.state,
    addressCountry: 'BR',
  },
  areaServed: cities.map((c) => ({ '@type': 'City', name: `${c.name}, RS` })),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  ...(site.email && { email: site.email }),
  ...((site.instagram || site.facebook || site.googleBusiness) && {
    sameAs: [site.instagram, site.facebook, site.googleBusiness].filter(Boolean),
  }),
};

const breadcrumb =
  crumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Início', href: '/' }, ...crumbs].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(c.href, site.url).href,
        })),
      }
    : null;

const jsonLd = [business, breadcrumb, ...schema].filter(Boolean);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.gtmId && (
      <script is:inline define:vars={{ id: site.gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', id);
      </script>
    )}
    {site.googleAdsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAdsId}`}></script>
        <script is:inline define:vars={{ adsId: site.googleAdsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', adsId);
        </script>
      </>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#083bc3" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/img/logo.webp" as="image" type="image/webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap"
    />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

  </head>
  <body>
    {site.gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <FloatingCTA />
    <script is:inline>
      // Envia cliques de WhatsApp e telefone para o Google Tag Manager / GA4.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href');
        var tipo = href.indexOf('api.whatsapp.com') > -1 ? 'whatsapp' : href.indexOf('tel:') === 0 ? 'telefone' : null;
        if (!tipo) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'clique_contato', tipo_contato: tipo, pagina: location.pathname });
      });
    </script>
    <script is:inline>
(function () {
  var ENDPOINT = "https://ofuecftfvtpgzupqmdcx.supabase.co/functions/v1/track";
  var SITE_KEY = "braga_d89212f13306";
  try {
    var q = new URLSearchParams(location.search);
    var gclid = q.get("gclid") || q.get("gbraid") || q.get("wbraid");
    if (!gclid) return;

    var vid;
    try { vid = localStorage.getItem("_rc_vid"); if (!vid) { vid = Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem("_rc_vid", vid); } } catch (e) {}

    var parts = [navigator.userAgent, navigator.language, screen.width + "x" + screen.height, screen.colorDepth,
      (Intl.DateTimeFormat().resolvedOptions().timeZone || ""), navigator.hardwareConcurrency || "", navigator.platform || ""].join("|");
    var h = 5381; for (var i = 0; i < parts.length; i++) { h = ((h << 5) + h + parts.charCodeAt(i)) >>> 0; }
    var fp = h.toString(36);

    var payload = {
      k: SITE_KEY, gclid: gclid, fp: fp, vid: vid,
      kw: q.get("kw"), mt: q.get("mt"), cid: q.get("cid"), agid: q.get("agid"), dev: q.get("dev"), net: q.get("net"),
      page: location.origin + location.pathname, ref: document.referrer
    };
    function send() {
      var body = JSON.stringify(payload);
      if (!(navigator.sendBeacon && navigator.sendBeacon(ENDPOINT, new Blob([body], { type: "text/plain" })))) {
        fetch(ENDPOINT, { method: "POST", body: body, keepalive: true, mode: "no-cors" });
      }
    }
    var done = false;
    function go() { if (!done) { done = true; send(); } }
    setTimeout(go, 1500);
    fetch("https://api6.ipify.org?format=json").then(function (r) { return r.json(); })
      .then(function (j) { if (j && j.ip) payload.ip6 = j.ip; go(); })["catch"](go);

    var t0 = Date.now(), sent = false;
    function leave() {
      if (sent) return; sent = true;
      var b = JSON.stringify({ k: SITE_KEY, gclid: gclid, ev: "leave", t: Date.now() - t0 });
      if (navigator.sendBeacon) navigator.sendBeacon(ENDPOINT, new Blob([b], { type: "text/plain" }));
    }
    addEventListener("pagehide", leave);
    document.addEventListener("visibilitychange", function () { if (document.visibilityState === "hidden") leave(); });
  } catch (e) {}
})();
</script>
    <script is:inline>
      // Avisa o robô de cliques que o visitante pago interagiu (tocou em botão/link ou rolou a página),
      // para a regra de "saiu em menos de 3s" não bloquear quem liga ou chama no WhatsApp na hora.
      (function () {
        try {
          var q = new URLSearchParams(location.search);
          var gclid = q.get('gclid') || q.get('gbraid') || q.get('wbraid');
          if (!gclid || !navigator.sendBeacon) return;
          var done = false;
          function engaged() {
            if (done) return;
            done = true;
            var b = JSON.stringify({ k: 'braga_d89212f13306', gclid: gclid, ev: 'engaged' });
            navigator.sendBeacon('https://ofuecftfvtpgzupqmdcx.supabase.co/functions/v1/track', new Blob([b], { type: 'text/plain' }));
          }
          document.addEventListener('pointerdown', function (e) { if (e.target.closest && e.target.closest('a, button, input, select, textarea, summary')) engaged(); }, true);
          document.addEventListener('keydown', engaged, true);
          addEventListener('scroll', function () { if (scrollY > 80) engaged(); }, { passive: true });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
